# Backend
APP_ENV=development
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
JWT_SECRET=replace-with-a-long-random-value
DATABASE_PATH=data/holdings.db
FRONTEND_URL=http://localhost:3000
SECURE_SESSION_COOKIE=false
OPEN_FIGI_API_KEY=your-open-figi-api-key

# Alpha Vantage and ECB FX (mock mode makes no outbound calls)
MARKETDATA_MODE=mock
ALPHAVANTAGE_API_KEY=
AV_MAX_PER_MINUTE=5
AV_MAX_PER_DAY=25
AV_MAX_PER_USER_PER_DAY=10
AV_LIMIT_BACKOFF=1h
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
FX_PROVIDER=ECB

# Positive server-side limits (optional; defaults shown)
MAX_USERS=10
MAX_PORTFOLIOS_PER_USER=10
MAX_ITEMS_PER_PORTFOLIO=30

# Frontend (put this in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8080
