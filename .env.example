# Backend
APP_ENV=development
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
JWT_SECRET=replace-with-a-long-random-value
DATABASE_PATH=data/holdings.db
FRONTEND_URL=http://localhost:3000
SECURE_SESSION_COOKIE=false
OPEN_FIGI_API_KEY=your-open-figi-api-key
TIINGO_API_KEY=your-tiingo-api-key

# Market data (mock mode makes no outbound calls). MARKETDATA_PRIMARY (YAHOO, EULERPOOL or
# ALPHAVANTAGE) is used for search, linking, quotes and historical prices. The other providers
# are fallbacks that only run when the user clicks, with their request cost shown first.
# Search additionally falls back Yahoo -> Eulerpool -> OpenFIGI automatically (no AV budget).
MARKETDATA_MODE=mock
MARKETDATA_PRIMARY=YAHOO
EULERPOOL_API_KEY=your-eulerpool-key
EULERPOOL_BASE_URL=https://api.eulerpool.com/api/1
EULERPOOL_SOFT_DAILY_LIMIT=500
EULERPOOL_QUOTE_TTL=15m
EULERPOOL_PROFILE_TTL=720h
# Yahoo Finance: primary source (unofficial API, needs cookie + crumb; no key). Serves current
# and historical prices and symbol search. Defaults shown.
YAHOO_COOKIE_URL=https://fc.yahoo.com
YAHOO_QUERY_URL=https://query1.finance.yahoo.com
YAHOO_FALLBACK_URL=https://query2.finance.yahoo.com
YAHOO_SOFT_DAILY_LIMIT=1000
YAHOO_MIN_INTERVAL=300ms
YAHOO_COOLDOWN=15m
ALPHAVANTAGE_API_KEY=
AV_MAX_PER_MINUTE=5
AV_MAX_PER_DAY=25
AV_MAX_PER_USER_PER_DAY=10
AV_LIMIT_BACKOFF=1h
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
FX_PROVIDER=ECB

# Positive server-side limits (optional; defaults shown)
MAX_USERS=10
MAX_PORTFOLIOS_PER_USER=10
MAX_ITEMS_PER_PORTFOLIO=30

# Frontend (put this in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8080
